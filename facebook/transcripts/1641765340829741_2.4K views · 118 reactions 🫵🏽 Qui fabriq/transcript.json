      "start": 352.765,
      "end": 354.925,
      "duration": 2.16,
      "start_srt": "00:05:52,765",
      "end_srt": "00:05:54,925",
      "start_txt": "[00:05:52]",
      "text": "toi tu payes pour imprimer ton livre. Bon l'essence est"
    },
