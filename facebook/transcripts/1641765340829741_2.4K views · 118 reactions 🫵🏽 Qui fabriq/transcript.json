      "id": 111,
      "start": 429.045,
      "end": 432.165,
      "duration": 3.12,
      "start_srt": "00:07:09,045",
      "end_srt": "00:07:12,165",
      "start_txt": "[00:07:09]",
      "text": "groupe pour pouvoir développer leurs activités. Le groupe"
