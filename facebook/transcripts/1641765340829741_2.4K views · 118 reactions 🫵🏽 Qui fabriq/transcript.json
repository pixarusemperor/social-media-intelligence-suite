      "start": 339.545,
      "end": 341.765,
      "duration": 2.22,
      "start_srt": "00:05:39,545",
      "end_srt": "00:05:41,765",
      "start_txt": "[00:05:39]",
      "text": "On part à l'école faire quoi si on peut pas faire ça nous-même."
