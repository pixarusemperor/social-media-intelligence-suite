      "duration": 3.36,
      "start_srt": "00:07:28,245",
      "end_srt": "00:07:31,605",
      "start_txt": "[00:07:28]",
      "text": "onze. Tu me fais un WhatsApp à ce numéro. Tu précises que tu"
