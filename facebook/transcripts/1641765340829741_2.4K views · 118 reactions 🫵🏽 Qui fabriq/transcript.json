      "id": 122,
      "start": 463.485,
      "end": 467.325,
      "duration": 3.84,
      "start_srt": "00:07:43,485",
      "end_srt": "00:07:47,325",
      "start_txt": "[00:07:43]",
      "text": "obligé de se battre, de travailler, d'avoir 800 idées"
