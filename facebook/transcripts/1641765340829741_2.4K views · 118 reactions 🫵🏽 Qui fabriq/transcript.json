      "end": 458.565,
      "duration": 2.58,
      "start_srt": "00:07:35,985",
      "end_srt": "00:07:38,565",
      "start_txt": "[00:07:35]",
      "text": "modalités pour que tu puisses nous rejoindre. Je crois que"
    },
