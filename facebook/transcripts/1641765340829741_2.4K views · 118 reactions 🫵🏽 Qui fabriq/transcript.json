      "end": 410.185,
      "duration": 2.1,
      "start_srt": "00:06:48,085",
      "end_srt": "00:06:50,185",
      "start_txt": "[00:06:48]",
      "text": "que oui ici tout le monde a l'argent, les gens ne vont plus"
