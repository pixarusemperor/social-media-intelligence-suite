      "start": 458.565,
      "end": 460.365,
      "duration": 1.8,
      "start_srt": "00:07:38,565",
      "end_srt": "00:07:40,365",
      "start_txt": "[00:07:38]",
      "text": "nous on est obligé de faire comme ça pour gagner de"
